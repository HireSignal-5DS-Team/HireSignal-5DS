# Copy to .env (git-ignored) at the repo root and fill in. Placeholders only, never commit real values.

# Ports (CLAUDE.md rule 7: n8n 5678, station API 8010, Ollama 11434, llama.cpp 8090)
N8N_PORT=5678
STATION_API_PORT=8010

# Local LLM server: llama.cpp llama-server, one Qwen3-4B base + Matcher LoRA switched per request (scripts/start_llm.ps1)
LLM_PORT=8090
LLM_BASE_URL=http://127.0.0.1:8090/v1
LLM_MODEL=qwen3-4b
LLM_MODEL_FILE=models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_LORA_FILE=models/hiresignal-lora-f16.gguf
LLM_GPU_LAYERS=all
LLM_CTX=4096
# Adapter scale per request: 0 = plain Qwen3-4B (Profile, Job Agent), 1 = Matcher
LLM_SCALE_PLAIN=0
LLM_SCALE_MATCHER=1

# Ollama (later: vision model for the Reader, tiny Report Writer candidates)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud backup LLM (OpenAI-compatible API), switch with LLM_BACKEND=cloud
LLM_BACKEND=local
CLOUD_LLM_BASE_URL=<cloud-openai-compatible-base-url>
CLOUD_LLM_API_KEY=<your-api-key>
CLOUD_LLM_MODEL=<model-name>

# OCR (Tesseract, UB Mannheim build; no global PATH change)
TESSERACT_CMD=<path-to>\tesseract.exe

# Reader multimodal (T10; services/reader/multimodal.py; chosen on dev, see docs/MULTIMODAL_REPORT.md). Defaults shown.
# Mode for image pages (photos, scanned PDF pages): ocr | vision | late (late fusion, main) | early (early fusion)
READER_MODE=late
# Vision model served by our Ollama (scripts/start_ollama.ps1, models in models/ollama); keep_alive 0 = unload after
# each page, so the vision model and llama-server do not hold the 6 GB GPU at the same time
READER_VISION_MODEL=qwen2.5vl:3b
READER_VISION_KEEP_ALIVE=0
READER_VISION_MAX_SIDE=1536
READER_VISION_TIMEOUT_S=300
# Late fusion: merge = vision_backbone | ocr_backbone; an OCR word replaces the vision word only if its Tesseract
# confidence >= READER_FUSION_MIN_CONF (101 = never: on dev photos Tesseract confidence was not a reliable signal)
READER_FUSION_MERGE=vision_backbone
READER_FUSION_MIN_CONF=101
# Late fusion: 1 = run Tesseract (CPU) and the vision call (GPU) for a page at the same time (T10b; identical output,
# faster); 0 = the old sequential path. Pages of a multi-page file still go one after another (one vision call at a time)
READER_PARALLEL=1

# Station API (services/api.py, port STATION_API_PORT). Defaults shown; all optional.
LLM_TIMEOUT_S=180
# 1 = Profile/Job ask llama-server for a JSON object (response_format json_object); 0 if a server rejects it
LLM_JSON_MODE=1
# Profile parse: V2-only fixes (chunks of 800 characters, at most 768 output tokens)
PROFILE_CHUNK_CHARS=800
PROFILE_MAX_TOKENS=768
JOB_MAX_TOKENS=768
# Prompt versions (T15, chosen on dev): Profile parse v3 (skills grouped by line, no truncation), Job Agent v2
PROFILE_PROMPT_VERSION=profile-v3
JOB_PROMPT_VERSION=job-v2
# Matcher knowledge: BM25 over ESCO, top k (used only when /match gets no knowledge_refs)
MATCHER_K=3
# RAG station POST /rag/search (T09, chosen on dev = V6; see rag/RAG_REPORT.md). Defaults shown.
# RAG_SEARCH: bm25 | dense | hybrid; RAG_EMBED: all-MiniLM-L6-v2 | multilingual-e5-base | bge-small-en-v1.5
RAG_CHUNKING=A
RAG_SEARCH=dense
RAG_EMBED=all-MiniLM-L6-v2
# Cross-encoder reranker (empty = none; ms-marco-MiniLM-L-6-v2 | bge-reranker-base) and ESCO graph expansion (0/1)
RAG_RERANKER=
RAG_GRAPH=0
# Vector store: qdrant (local mode, rag/index/) | numpy
RAG_STORE=qdrant
# 1 = no knowledge block when every skill term of the requirement is already in the CV
RAG_ONLY_WHEN_MISSING=1
# cuda | cpu (default: cuda if available)
# RAG_DEVICE=cuda
# Identity files (git-ignored), one private/<cv_id>.json per CV
PRIVATE_DIR=private
# Matcher output limit (V2 used 192; long multi-quote replies were cut, see tasks/T04_report.md)
MATCHER_MAX_TOKENS=384
# Confidence check in /match (T07, chosen on dev): p(model decision) below this -> UNCERTAIN + match:low_confidence
MATCHER_TAU_CONF=0.72
# Judge station /judge (T07, chosen on dev): NLI model folder, device (cuda|cpu), hypothesis template, thresholds
JUDGE_MODEL_DIR=models/DeBERTa-v3-base-mnli-fever-anli
JUDGE_DEVICE=cuda
JUDGE_HYPOTHESIS=v2
JUDGE_TAU_PASS=0.05
JUDGE_TAU_FAIL=0.15
# Outcome gate /outcome (T08, settings chosen on dev in T08b): invite needs every must-have MET (no outcome-relevant
# flag) and score >= T_INVITE; pair-level review reasons: block (send to review) | info (list only).
OUTCOME_T_INVITE=85
OUTCOME_PAIR_FLAGS=info
# Judge in the gate: all | none; a Judge doubt on a MET must-have counts only if p(MET) < MET_MAX_CONF (empty = always);
# MAX_SUPPORT (empty = off): only if the Judge's entailment < it; SKIP_PROVEN=1: never for language / proven years
OUTCOME_JUDGE=all
OUTCOME_JUDGE_MET_MAX_CONF=0.999
OUTCOME_JUDGE_MAX_SUPPORT=
OUTCOME_JUDGE_SKIP_PROVEN=0

# Bias Auditor (station 5, T11; services/bias/auditor.py, POST /bias). The leakage check (config/bias_lexicon.json)
# always runs in /profile. Live swap test: on = re-check the must-haves with one counterfactual identity whenever the
# gate would decide automatically (invite / reject); a changed decision -> review (bias:swap_flip)
BIAS_SWAP=on

# Report Writer (station 7, T12; services/report/, POST /report). Default model = the plain Qwen3-4B on llama-server
# (LoRA scale 0: no extra GPU memory). The code fact checker reads every report; one retry with its errors; then the
# template (info flag report:template_fallback). REPORT_FALLBACK=error answers 502 instead of using the template.
REPORT_MODEL=qwen3-4b
# REPORT_BASE_URL=http://127.0.0.1:8090/v1
REPORT_LORA=1
REPORT_PROMPT=prompts/report_writer/v3.md
REPORT_FALLBACK=template
REPORT_MAX_TOKENS=1400

# n8n webhook shared secret (T13): every webhook request needs the header X-HireSignal-Token: <WEBHOOK_TOKEN>.
# Generate one, e.g. .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))", and keep it in .env only.
WEBHOOK_TOKEN=<random-secret>
