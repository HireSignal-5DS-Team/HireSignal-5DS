# Copy to .env (git-ignored) and fill in. Placeholders only, never commit real values.

# Ports (CLAUDE.md: n8n 5678, station API 8010, local LLM server 8090)
N8N_PORT=5678
STATION_API_PORT=8010
LLM_SERVER_PORT=8090

# LLM backend: "local" or "cloud" (OpenAI-compatible API)
LLM_BACKEND=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8090/v1
CLOUD_LLM_BASE_URL=<cloud-openai-compatible-base-url>
CLOUD_LLM_API_KEY=<your-api-key>
CLOUD_LLM_MODEL=<model-name>

# Model locations (no hard-coded user paths in code)
MODELS_DIR=<path-to-models-dir>
