# HireSignal Matcher — production configuration (copy to .env, never commit real keys).
# The Matcher talks to ANY OpenAI-compatible /v1/chat/completions endpoint serving Qwen3-4B-Instruct-2507.
#
# Hosted (production): set the provider's endpoint + exact model id as published by that provider, and the key.
#   Check the id/price on the provider page before use; not verifiable from the cloud build env (provider hosts blocked).
HS_LLM_BASE_URL=https://<provider-host>/v1
HS_LLM_MODEL=<provider model id for Qwen3-4B-Instruct-2507>
HS_LLM_API_KEY=<secret, set in the deployment environment only>
HS_LLM_REVISION=Qwen/Qwen3-4B-Instruct-2507
#
# Local / self-hosted alternative (same code path), e.g. llama.cpp server on the team laptop (RTX 4050):
#   python -m llama_cpp.server --model Qwen3-4B-Instruct-2507-Q4_K_M.gguf --model_alias Qwen/Qwen3-4B-Instruct-2507 \
#          --n_ctx 4096 --n_gpu_layers -1 --port 8080
# HS_LLM_BASE_URL=http://127.0.0.1:8080/v1
# HS_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
#
# RAG (team RAG code, BM25 over ESCO), Judge checkpoint
HIRESIGNAL_RAG_DIR=../HireSignal-rag/rag
HS_JUDGE_DIR=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
HS_JUDGE_TAU=0.65
#
# Privacy: only anonymised CV text may be sent to a hosted provider (the Reader/Profile agents anonymise first);
# a data-processing agreement with the provider is required for real candidate data (GDPR).
#
# Fine-tuned Matcher (LoRA adapter Daibalooo/hiresignal-qwen3-4b-matcher-lora on Qwen/Qwen3-4B-Instruct-2507):
#   NOT the default until scripts/eval_hs_lora.sh shows it beats the untuned base under identical conditions.
#   Local: scripts/serve_qwen4b_lora.sh <adapter-dir> 8081   (llama.cpp --lora_path on the same Q4_K_M base)
#     HS_LLM_BASE_URL=http://127.0.0.1:8081/v1
#     HS_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507+lora
#   Hosted: the provider must either accept a LoRA adapter on this exact base (e.g. vLLM --enable-lora --lora-modules
#     hs=<adapter>) or serve a merged copy; the RAG, Validator, Bias Auditor and Judge need no change (same API + JSON).
#   The adapter repo is private: HF_TOKEN (read-only, fine-grained) as an environment secret, never in git or chat.
