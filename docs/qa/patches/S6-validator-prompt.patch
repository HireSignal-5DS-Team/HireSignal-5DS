+def fence_safe(text):
+    """CV text cannot close or reopen the CV block (prompt injection, QA-007): delimiter runs are neutralised."""
+    return text.replace("<<<", "\u2039\u2039\u2039").replace(">>>", "\u203a\u203a\u203a")
+
+
