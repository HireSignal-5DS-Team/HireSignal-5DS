        "jsCode": "// One line per failed execution: time, workflow, node, message (T05). No CV data is written here.\nconst e = $json.execution ?? {}, wf = $json.workflow ?? {};\nconst msg = String((e.error ?? {}).message ?? 'unknown error').replace(/\\s+/g, ' ').slice(0, 500);\nconst line = [new Date().toISOString(), `workflow=${wf.name}`, `node=${e.lastNodeExecuted}`,\n              `execution=${e.id}`, `message=${msg}`].join('\\t') + '\\n';\nreturn [{ json: { line } }];"
